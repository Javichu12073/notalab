---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Calculadora de Nota Media | NotaLab"
  description="Calcula tu nota media de forma rápida y gratuita. Añade tus asignaturas y descubre tu media final."
>
  <header class="header">
    <a href="/" class="logo">
      <span>Nota</span>Lab
    </a>

    <a href="/" class="back">← Volver al inicio</a>
  </header>

  <main>
    <section class="hero">
      <div class="badge">📊 CALCULADORA DE NOTAS</div>

      <h1>Calculadora de nota media</h1>

      <p>
        Introduce tus asignaturas y sus notas para calcular tu media de forma
        rápida y sencilla.
      </p>
    </section>

    <section class="calculator">
      <div class="card">
        <h2>Tus asignaturas</h2>

        <div id="subjects">
          <div class="subject">
            <input
              type="text"
              class="subject-name"
              placeholder="Nombre de la asignatura"
            />

            <input
              type="number"
              class="subject-grade"
              min="0"
              max="10"
              step="0.01"
              placeholder="Nota"
            />

            <button type="button" class="remove">×</button>
          </div>

          <div class="subject">
            <input
              type="text"
              class="subject-name"
              placeholder="Nombre de la asignatura"
            />

            <input
              type="number"
              class="subject-grade"
              min="0"
              max="10"
              step="0.01"
              placeholder="Nota"
            />

            <button type="button" class="remove">×</button>
          </div>
        </div>

        <button type="button" id="addSubject" class="add">
          + Añadir asignatura
        </button>
      </div>

      <button type="button" id="calculate" class="calculate">
        Calcular media
      </button>

      <div id="error" class="error"></div>

      <div id="result" class="result">
        <p>Tu nota media es</p>

        <strong id="average">0,00</strong>

        <span>/ 10</span>
      </div>
    </section>

    <section class="info">
      <h2>¿Cómo se calcula la nota media?</h2>

      <p>
        La nota media se obtiene sumando todas las notas y dividiendo el
        resultado entre el número de asignaturas.
      </p>

      <div class="formula">
        <strong>Fórmula</strong>

        <span>
          Nota media = suma de todas las notas ÷ número de asignaturas
        </span>
      </div>

      <p>
        Por ejemplo, si tienes tres asignaturas con notas 7, 8 y 9:
      </p>

      <div class="example">
        <strong>(7 + 8 + 9) ÷ 3 = 8</strong>
      </div>

      <p>
        Esta calculadora está pensada para medias simples. Si tus asignaturas
        tienen diferentes créditos o pesos, utiliza nuestra
        <a href="/media-ponderada">calculadora de media ponderada</a>.
      </p>
    </section>
  </main>

  <footer>
    <div class="footer-logo">
      <span>Nota</span>Lab
    </div>

    <p>Herramientas gratuitas para estudiantes.</p>

    <div class="footer-links">
      <a href="/">Inicio</a>
      <a href="/media-ponderada">Media ponderada</a>
      <a href="/calculadora-nota-necesaria">Nota necesaria</a>
      <a href="/simulador-notas">Simulador</a>
      <a href="/calculadora-pau">Calculadora PAU</a>
    </div>

    <small>© 2026 NotaLab</small>
  </footer>

  <script>
    const subjects = document.getElementById("subjects");
    const addSubject = document.getElementById("addSubject");
    const calculate = document.getElementById("calculate");
    const error = document.getElementById("error");
    const result = document.getElementById("result");
    const average = document.getElementById("average");

    function updateRemoveButtons() {
      const buttons = document.querySelectorAll(".remove");

      buttons.forEach((button) => {
        button.addEventListener("click", () => {
          const allSubjects = document.querySelectorAll(".subject");

          if (allSubjects.length > 1) {
            button.parentElement?.remove();
            error.textContent = "";
          }
        });
      });
    }

    addSubject?.addEventListener("click", () => {
      const subject = document.createElement("div");

      subject.className = "subject";

      subject.innerHTML = `
        <input
          type="text"
          class="subject-name"
          placeholder="Nombre de la asignatura"
        />

        <input
          type="number"
          class="subject-grade"
          min="0"
          max="10"
          step="0.01"
          placeholder="Nota"
        />

        <button type="button" class="remove">×</button>
      `;

      subjects?.appendChild(subject);

      updateRemoveButtons();
    });

    calculate?.addEventListener("click", () => {
      error.textContent = "";
      result.classList.remove("show");

      const gradeInputs = document.querySelectorAll(
        ".subject-grade"
      ) as NodeListOf<HTMLInputElement>;

      const grades: number[] = [];

      for (const input of gradeInputs) {
        if (input.value === "") {
          error.textContent =
            "Introduce una nota en todas las asignaturas.";

          return;
        }

        const grade = Number(input.value);

        if (grade < 0 || grade > 10) {
          error.textContent =
            "Las notas deben estar entre 0 y 10.";

          return;
        }

        grades.push(grade);
      }

      if (grades.length === 0) {
        error.textContent =
          "Añade al menos una asignatura.";

        return;
      }

      const total = grades.reduce(
        (sum, grade) => sum + grade,
        0
      );

      const media = total / grades.length;

      average.textContent = media
        .toFixed(2)
        .replace(".", ",");

      result.classList.add("show");
    });

    updateRemoveButtons();
  </script>

  <style>
    :global(*) {
      box-sizing: border-box;
    }

    :global(body) {
      margin: 0;
      font-family:
        Inter,
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;
      background: #f8fafc;
      color: #0f172a;
    }

    .header {
      height: 72px;
      background: white;
      border-bottom: 1px solid #e2e8f0;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 7%;
    }

    .logo,
    .footer-logo {
      text-decoration: none;
      color: #0f172a;
      font-size: 25px;
      font-weight: 800;
    }

    .logo span,
    .footer-logo span {
      color: #16a085;
    }

    .back {
      color: #475569;
      text-decoration: none;
      font-size: 14px;
      font-weight: 600;
    }

    .back:hover {
      color: #16a085;
    }

    main {
      max-width: 850px;
      margin: auto;
      padding: 55px 20px 80px;
    }

    .hero {
      text-align: center;
      margin-bottom: 40px;
    }

    .badge {
      display: inline-block;
      background: #e8f8f5;
      color: #12806a;
      padding: 8px 14px;
      border-radius: 999px;
      font-size: 12px;
      font-weight: 800;
      letter-spacing: 0.4px;
      margin-bottom: 18px;
    }

    .hero h1 {
      font-size: clamp(32px, 5vw, 48px);
      line-height: 1.05;
      margin: 0 0 16px;
      letter-spacing: -1.5px;
    }

    .hero p {
      color: #64748b;
      font-size: 17px;
      max-width: 620px;
      margin: auto;
      line-height: 1.6;
    }

    .calculator {
      display: flex;
      flex-direction: column;
      gap: 18px;
    }

    .card {
      background: white;
      border: 1px solid #e2e8f0;
      border-radius: 18px;
      padding: 25px;
      box-shadow: 0 8px 25px rgba(15, 23, 42, 0.04);
    }

    .card h2 {
      margin: 0 0 20px;
      font-size: 20px;
    }

    :global(.subject) {
      display: grid;
      grid-template-columns: 1fr 150px 42px;
      gap: 10px;
      margin-bottom: 10px;
    }

    :global(.subject input) {
      width: 100%;
      height: 48px;
      border: 1px solid #cbd5e1;
      border-radius: 10px;
      padding: 0 13px;
      font-size: 15px;
      background: white;
      outline: none;
    }

    :global(.subject input:focus) {
      border-color: #16a085;
      box-shadow: 0 0 0 3px rgba(22, 160, 133, 0.1);
    }

    :global(.subject .remove) {
      width: 42px;
      height: 48px;
      border: 1px solid #fecaca;
      background: #fff5f5;
      color: #dc2626;
      border-radius: 10px;
      font-size: 23px;
      cursor: pointer;
    }

    :global(.subject .remove:hover) {
      background: #fee2e2;
    }

    .add {
      border: 0;
      background: #e8f8f5;
      color: #12806a;
      border-radius: 10px;
      height: 45px;
      padding: 0 18px;
      font-weight: 800;
      cursor: pointer;
      margin-top: 5px;
    }

    .add:hover {
      background: #d8f2ec;
    }

    .calculate {
      width: 100%;
      height: 56px;
      border: 0;
      border-radius: 13px;
      background: #16a085;
      color: white;
      font-size: 16px;
      font-weight: 800;
      cursor: pointer;
      box-shadow: 0 8px 20px rgba(22, 160, 133, 0.2);
    }

    .calculate:hover {
      background: #128f76;
    }

    .error {
      min-height: 20px;
      color: #dc2626;
      text-align: center;
      font-size: 14px;
      font-weight: 600;
    }

    .result {
      display: none;
      background: #0f172a;
      color: white;
      border-radius: 20px;
      padding: 35px 25px;
      text-align: center;
    }

    .result.show {
      display: block;
    }

    .result p {
      color: #94a3b8;
      margin: 0 0 10px;
      font-size: 15px;
      font-weight: 700;
    }

    .result strong {
      font-size: 58px;
      line-height: 1;
    }

    .result span {
      color: #94a3b8;
      font-size: 15px;
    }

    .info {
      margin-top: 50px;
      background: white;
      border: 1px solid #e2e8f0;
      border-radius: 18px;
      padding: 30px;
    }

    .info h2 {
      margin-top: 0;
    }

    .info p {
      color: #64748b;
      line-height: 1.7;
      font-size: 15px;
    }

    .info a {
      color: #16a085;
      font-weight: 700;
      text-decoration: none;
    }

    .formula {
      background: #f8fafc;
      border-left: 4px solid #16a085;
      padding: 16px;
      margin: 20px 0;
      border-radius: 0 10px 10px 0;
    }

    .formula strong {
      display: block;
      font-size: 15px;
      margin-bottom: 7px;
    }

    .formula span {
      color: #475569;
      font-size: 14px;
    }

    .example {
      background: #e8f8f5;
      color: #12806a;
      padding: 16px;
      border-radius: 10px;
      text-align: center;
      font-size: 16px;
    }

    footer {
      border-top: 1px solid #e2e8f0;
      background: white;
      padding: 35px 20px;
      text-align: center;
    }

    .footer-logo {
      font-size: 22px;
    }

    footer p {
      color: #64748b;
      margin: 8px 0 20px;
    }

    .footer-links {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 18px;
      margin-bottom: 20px;
    }

    .footer-links a {
      color: #64748b;
      text-decoration: none;
      font-size: 13px;
    }

    .footer-links a:hover {
      color: #16a085;
    }

    footer small {
      color: #94a3b8;
    }

    @media (max-width: 600px) {
      .header {
        padding: 0 20px;
      }

      :global(.subject) {
        grid-template-columns: 1fr 1fr 42px;
      }

      :global(.subject .subject-name) {
        grid-column: 1 / 3;
      }

      :global(.subject .subject-grade) {
        grid-column: 1;
      }

      :global(.subject .remove) {
        grid-column: 3;
        grid-row: 2;
      }

      .card {
        padding: 20px;
      }

      .info {
        padding: 22px;
      }
    }
  </style>
</Layout>