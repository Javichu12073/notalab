---
import Layout from "../layouts/Layout.astro";

const tools = [
  {
    title: "Calculadora de nota media",
    description:
      "Calcula rápidamente la media de tus asignaturas.",
    href: "/calculadora-nota-media",
    icon: "📊",
  },
  {
    title: "Media ponderada",
    description:
      "Calcula tu nota teniendo en cuenta diferentes porcentajes.",
    href: "/media-ponderada",
    icon: "⚖️",
  },
  {
    title: "Nota necesaria",
    description:
      "Descubre qué nota necesitas para alcanzar tu objetivo.",
    href: "/calculadora-nota-necesaria",
    icon: "🎯",
  },
  {
    title: "Simulador de notas",
    description:
      "Prueba diferentes notas y descubre cómo cambiaría tu media.",
    href: "/simulador-notas",
    icon: "🔮",
  },
  {
    title: "Calculadora PAU",
    description:
      "Calcula tu nota de acceso y admisión a la universidad sobre 14.",
    href: "/calculadora-pau",
    icon: "🎓",
  },
];
---

<Layout
  title="NotaLab — Calcula tus notas y planifica tus objetivos"
  description="Calculadoras gratuitas para estudiantes. Calcula tu nota media, media ponderada, nota necesaria, simula resultados y calcula tu nota PAU."
>
  <main>
    <section class="hero">
      <div class="badge">HERRAMIENTAS GRATUITAS PARA ESTUDIANTES</div>

      <h1>
        Calcula tus notas.<br />
        <span>Planifica tus objetivos.</span>
      </h1>

      <p>
        Calculadoras sencillas y gratuitas para ayudarte a entender tus
        notas, planificar tus objetivos académicos y tomar mejores
        decisiones.
      </p>

      <a href="#herramientas" class="hero-button">
        Ver calculadoras →
      </a>
    </section>

    <section id="herramientas" class="tools-section">
      <div class="section-heading">
        <div>
          <p class="eyebrow">HERRAMIENTAS</p>
          <h2>Calcula lo que necesitas</h2>
        </div>

        <p>
          Todas nuestras calculadoras son gratuitas y no requieren registro.
        </p>
      </div>

      <div class="tools-grid">
        {
          tools.map((tool) => (
            <a href={tool.href} class="tool-card">
              <div class="tool-icon">{tool.icon}</div>

              <h3>{tool.title}</h3>

              <p>{tool.description}</p>

              <span class="tool-link">
                Calcular →
              </span>
            </a>
          ))
        }
      </div>
    </section>

    <section id="sobre-notalab" class="about">
      <div>
        <p class="eyebrow">¿QUÉ ES NOTALAB?</p>

        <h2>
          Menos cálculos.<br />
          Más tiempo para estudiar.
        </h2>
      </div>

      <div class="about-text">
        <p>
          NotaLab nace para ofrecer herramientas académicas rápidas,
          sencillas y gratuitas para estudiantes.
        </p>

        <p>
          Desde calcular una media hasta saber qué nota necesitas para
          alcanzar un objetivo o estimar tu nota de admisión a la
          universidad.
        </p>

        <div class="features">
          <div>
            <strong>✓ Gratis</strong>
            <span>Sin registros ni pagos.</span>
          </div>

          <div>
            <strong>✓ Sencillo</strong>
            <span>Resultados claros y rápidos.</span>
          </div>

          <div>
            <strong>✓ Desde cualquier dispositivo</strong>
            <span>Móvil, tablet u ordenador.</span>
          </div>
        </div>
      </div>
    </section>
  </main>

  <style>
    :global(*) {
      box-sizing: border-box;
    }

    :global(html) {
      scroll-behavior: smooth;
    }

    :global(body) {
      margin: 0;
      font-family:
        Inter,
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;
      background: #f8fafc;
      color: #0f172a;
    }

    .hero {
      text-align: center;
      padding: 100px 20px 110px;
      background:
        radial-gradient(
          circle at top,
          rgba(22, 160, 133, 0.1),
          transparent 40%
        ),
        #f8fafc;
    }

    .badge,
    .eyebrow {
      color: #16a085;
      font-size: 12px;
      font-weight: 800;
      letter-spacing: 1px;
    }

    .badge {
      display: inline-block;
      background: #e8f8f5;
      padding: 9px 15px;
      border-radius: 999px;
      margin-bottom: 22px;
    }

    .hero h1 {
      margin: 0;
      font-size: clamp(42px, 7vw, 76px);
      line-height: 1.02;
      letter-spacing: -3px;
    }

    .hero h1 span {
      color: #16a085;
    }

    .hero p {
      max-width: 650px;
      margin: 25px auto 32px;
      color: #64748b;
      font-size: 18px;
      line-height: 1.7;
    }

    .hero-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: #16a085;
      color: white;
      text-decoration: none;
      padding: 15px 24px;
      border-radius: 11px;
      font-weight: 800;
      box-shadow: 0 8px 20px rgba(22, 160, 133, 0.2);
    }

    .hero-button:hover {
      background: #128f76;
    }

    .tools-section {
      max-width: 1200px;
      margin: auto;
      padding: 80px 20px;
    }

    .section-heading {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 30px;
      margin-bottom: 35px;
    }

    .section-heading h2,
    .about h2 {
      margin: 8px 0 0;
      font-size: 36px;
      letter-spacing: -1.2px;
    }

    .section-heading > p {
      max-width: 330px;
      color: #64748b;
      line-height: 1.6;
      font-size: 14px;
    }

    .tools-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
    }

    .tool-card {
      background: white;
      border: 1px solid #e2e8f0;
      border-radius: 18px;
      padding: 25px;
      text-decoration: none;
      color: #0f172a;
      transition:
        transform 0.2s,
        box-shadow 0.2s,
        border-color 0.2s;
    }

    .tool-card:hover {
      transform: translateY(-4px);
      border-color: #a7e3d5;
      box-shadow: 0 15px 35px rgba(15, 23, 42, 0.08);
    }

    .tool-icon {
      width: 50px;
      height: 50px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #e8f8f5;
      border-radius: 13px;
      font-size: 23px;
      margin-bottom: 18px;
    }

    .tool-card h3 {
      margin: 0 0 9px;
      font-size: 19px;
    }

    .tool-card p {
      margin: 0 0 20px;
      color: #64748b;
      font-size: 14px;
      line-height: 1.6;
    }

    .tool-link {
      color: #16a085;
      font-size: 14px;
      font-weight: 800;
    }

    .about {
      max-width: 1200px;
      margin: 20px auto 90px;
      padding: 70px;
      background: #0f172a;
      color: white;
      border-radius: 25px;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 70px;
    }

    .about .eyebrow {
      color: #5eead4;
    }

    .about h2 {
      font-size: 42px;
      line-height: 1.1;
    }

    .about-text > p {
      color: #cbd5e1;
      line-height: 1.7;
    }

    .features {
      margin-top: 30px;
      display: grid;
      gap: 17px;
    }

    .features div {
      display: flex;
      flex-direction: column;
      gap: 3px;
    }

    .features strong {
      color: #5eead4;
    }

    .features span {
      color: #94a3b8;
      font-size: 14px;
    }

    @media (max-width: 800px) {
      .tools-grid {
        grid-template-columns: 1fr 1fr;
      }

      .about {
        margin-left: 20px;
        margin-right: 20px;
        padding: 40px 25px;
        grid-template-columns: 1fr;
        gap: 25px;
      }
    }

    @media (max-width: 550px) {
      .hero {
        padding: 75px 20px 80px;
      }

      .hero h1 {
        letter-spacing: -2px;
      }

      .tools-grid {
        grid-template-columns: 1fr;
      }

      .section-heading {
        display: block;
      }

      .section-heading > p {
        margin-top: 15px;
      }

      .about h2 {
        font-size: 34px;
      }
    }
  </style>
</Layout>