---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Calculadora PAU y Nota de Admisión | NotaLab"
  description="Calcula tu nota de acceso y estima tu nota de admisión a la universidad sobre 14 puntos."
>
  <header class="header">
    <a href="/" class="logo">
      <span>Nota</span>Lab
    </a>

    <a href="/" class="back">← Volver al inicio</a>
  </header>

  <main>
    <section class="hero">
      <div class="badge">🎓 PAU · SELECTIVIDAD</div>

      <h1>Calculadora de nota de admisión</h1>

      <p>
        Calcula tu nota de acceso y estima tu nota de admisión a la universidad
        sobre 14 puntos.
      </p>
    </section>

    <section class="calculator">
      <div class="card">
        <h2>1. Nota de Bachillerato</h2>

        <label for="bachillerato">
          Media de Bachillerato
          <span>0 - 10</span>
        </label>

        <input
          type="number"
          id="bachillerato"
          min="0"
          max="10"
          step="0.01"
          placeholder="Ej. 8,25"
        />
      </div>

      <div class="card">
        <h2>2. PAU</h2>

        <label for="pau">
          Media de la fase de acceso
          <span>0 - 10</span>
        </label>

        <input
          type="number"
          id="pau"
          min="0"
          max="10"
          step="0.01"
          placeholder="Ej. 7,80"
        />

        <p class="help">
          Introduce la media de las materias que forman tu fase de acceso.
        </p>
      </div>

      <div class="card">
        <h2>3. Materias para subir nota</h2>

        <p class="card-description">
          Añade hasta cuatro materias y selecciona el coeficiente de
          ponderación que corresponda a la carrera que quieres estudiar.
        </p>

        <div id="subjects">
          <div class="subject">
            <input
              type="text"
              class="subject-name"
              placeholder="Materia"
            />

            <input
              type="number"
              class="subject-grade"
              min="0"
              max="10"
              step="0.01"
              placeholder="Nota"
            />

            <select class="coefficient">
              <option value="0">0,0</option>
              <option value="0.1">0,1</option>
              <option value="0.2">0,2</option>
            </select>

            <button type="button" class="remove">×</button>
          </div>

          <div class="subject">
            <input
              type="text"
              class="subject-name"
              placeholder="Materia"
            />

            <input
              type="number"
              class="subject-grade"
              min="0"
              max="10"
              step="0.01"
              placeholder="Nota"
            />

            <select class="coefficient">
              <option value="0">0,0</option>
              <option value="0.1">0,1</option>
              <option value="0.2">0,2</option>
            </select>

            <button type="button" class="remove">×</button>
          </div>
        </div>

        <button type="button" id="addSubject" class="add">
          + Añadir materia
        </button>
      </div>

      <button id="calculate" class="calculate" type="button">
        Calcular mi nota
      </button>

      <div id="error" class="error"></div>

      <div id="result" class="result">
        <p class="result-label">Tu nota de acceso</p>

        <strong id="accessGrade">0,00</strong>

        <span>/ 10</span>

        <div class="separator"></div>

        <p class="result-label">Tu nota de admisión estimada</p>

        <strong id="admissionGrade">0,00</strong>

        <span>/ 14</span>

        <div id="details" class="details"></div>
      </div>
    </section>

    <section class="info">
      <h2>¿Cómo se calcula?</h2>

      <p>
        La nota de acceso combina la media de Bachillerato y la nota de la
        fase de acceso de la PAU.
      </p>

      <div class="formula">
        <strong>Nota de acceso</strong>

        <span>
          (Media de Bachillerato × 0,6) + (PAU × 0,4)
        </span>
      </div>

      <p>
        Para obtener una nota de admisión superior a 10 puntos se pueden
        añadir materias ponderables. Cada universidad y grado puede utilizar
        coeficientes diferentes.
      </p>

      <div class="formula">
        <strong>Nota de admisión</strong>

        <span>
          Nota de acceso + materias ponderables
        </span>
      </div>

      <p class="note">
        <strong>Importante:</strong> los coeficientes de ponderación dependen
        de la universidad, el grado y la convocatoria. Comprueba siempre los
        coeficientes oficiales antes de utilizar el resultado para una
        solicitud universitaria.
      </p>
    </section>
  </main>

  <footer>
    <div class="footer-logo">
      <span>Nota</span>Lab
    </div>

    <p>Herramientas gratuitas para estudiantes.</p>

    <div class="footer-links">
      <a href="/">Inicio</a>
      <a href="/calculadora-nota-media">Nota media</a>
      <a href="/media-ponderada">Media ponderada</a>
      <a href="/calculadora-nota-necesaria">Nota necesaria</a>
      <a href="/simulador-notas">Simulador</a>
    </div>

    <small>© 2026 NotaLab</small>
  </footer>

  <script>
    const subjects = document.getElementById("subjects");
    const addSubject = document.getElementById("addSubject");
    const calculate = document.getElementById("calculate");
    const error = document.getElementById("error");
    const result = document.getElementById("result");

    const bachillerato = document.getElementById(
      "bachillerato"
    ) as HTMLInputElement;

    const pau = document.getElementById(
      "pau"
    ) as HTMLInputElement;

    const accessGrade = document.getElementById(
      "accessGrade"
    ) as HTMLElement;

    const admissionGrade = document.getElementById(
      "admissionGrade"
    ) as HTMLElement;

    const details = document.getElementById(
      "details"
    ) as HTMLElement;

    function formatNumber(number: number) {
      return number.toFixed(2).replace(".", ",");
    }

    function updateRemoveButtons() {
      const buttons = document.querySelectorAll(".remove");

      buttons.forEach((button) => {
        button.addEventListener("click", () => {
          const allSubjects =
            document.querySelectorAll(".subject");

          if (allSubjects.length > 1) {
            button.parentElement?.remove();
            error!.textContent = "";
          }
        });
      });
    }

    addSubject?.addEventListener("click", () => {
      const currentSubjects =
        document.querySelectorAll(".subject");

      if (currentSubjects.length >= 4) {
        error!.textContent =
          "Puedes añadir un máximo de 4 materias.";

        return;
      }

      error!.textContent = "";

      const subject =
        document.createElement("div");

      subject.className = "subject";

      subject.innerHTML = `
        <input
          type="text"
          class="subject-name"
          placeholder="Materia"
        />

        <input
          type="number"
          class="subject-grade"
          min="0"
          max="10"
          step="0.01"
          placeholder="Nota"
        />

        <select class="coefficient">
          <option value="0">0,0</option>
          <option value="0.1">0,1</option>
          <option value="0.2">0,2</option>
        </select>

        <button type="button" class="remove">×</button>
      `;

      subjects?.appendChild(subject);

      updateRemoveButtons();
    });

    calculate?.addEventListener("click", () => {
      error!.textContent = "";
      result!.classList.remove("show");

      if (
        bachillerato.value === "" ||
        pau.value === ""
      ) {
        error!.textContent =
          "Introduce tu media de Bachillerato y tu nota de PAU.";

        return;
      }

      const bach = Number(bachillerato.value);
      const pauGrade = Number(pau.value);

      if (
        bach < 0 ||
        bach > 10 ||
        pauGrade < 0 ||
        pauGrade > 10
      ) {
        error!.textContent =
          "Las notas deben estar entre 0 y 10.";

        return;
      }

      const access =
        bach * 0.6 +
        pauGrade * 0.4;

      const subjectElements =
        document.querySelectorAll(".subject");

      const validSubjects: {
        name: string;
        grade: number;
        coefficient: number;
        contribution: number;
      }[] = [];

      let invalidSubject = false;

      subjectElements.forEach((subject) => {
        const nameInput =
          subject.querySelector(
            ".subject-name"
          ) as HTMLInputElement;

        const gradeInput =
          subject.querySelector(
            ".subject-grade"
          ) as HTMLInputElement;

        const coefficientInput =
          subject.querySelector(
            ".coefficient"
          ) as HTMLSelectElement;

        if (gradeInput.value !== "") {
          const grade = Number(
            gradeInput.value
          );

          const coefficient =
            Number(coefficientInput.value);

          if (
            grade < 0 ||
            grade > 10
          ) {
            invalidSubject = true;
            return;
          }

          validSubjects.push({
            name:
              nameInput.value.trim() ||
              "Materia",
            grade,
            coefficient,
            contribution:
              grade * coefficient,
          });
        }
      });

      if (invalidSubject) {
        error!.textContent =
          "Las notas de las materias deben estar entre 0 y 10.";

        return;
      }

      validSubjects.sort(
        (a, b) =>
          b.contribution -
          a.contribution
      );

      const bestSubjects =
        validSubjects
          .filter(
            (subject) =>
              subject.coefficient > 0
          )
          .slice(0, 2);

      let extra = 0;

      bestSubjects.forEach(
        (subject) => {
          extra += subject.contribution;
        }
      );

      const admission = Math.min(
        14,
        access + extra
      );

      accessGrade.textContent =
        formatNumber(access);

      admissionGrade.textContent =
        formatNumber(admission);

      details.innerHTML = "";

      if (bestSubjects.length > 0) {
        const title =
          document.createElement("h3");

        title.textContent =
          "Materias utilizadas para subir nota";

        details.appendChild(title);

        bestSubjects.forEach(
          (subject) => {
            const item =
              document.createElement("div");

            item.className =
              "detail-item";

            item.innerHTML = `
              <span>
                ${subject.name}
                <small>
                  ${formatNumber(subject.grade)}
                  × ${subject.coefficient
                    .toString()
                    .replace(".", ",")}
                </small>
              </span>

              <strong>
                +${formatNumber(
                  subject.contribution
                )}
              </strong>
            `;

            details.appendChild(item);
          }
        );
      }

      result!.classList.add("show");
    });

    updateRemoveButtons();
  </script>

  <style>
    :global(*) {
      box-sizing: border-box;
    }

    :global(body) {
      margin: 0;
      font-family:
        Inter,
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;
      background: #f8fafc;
      color: #0f172a;
    }

    .header {
      height: 72px;
      background: white;
      border-bottom: 1px solid #e2e8f0;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 7%;
    }

    .logo,
    .footer-logo {
      text-decoration: none;
      color: #0f172a;
      font-size: 25px;
      font-weight: 800;
    }

    .logo span,
    .footer-logo span {
      color: #16a085;
    }

    .back {
      color: #475569;
      text-decoration: none;
      font-size: 14px;
      font-weight: 600;
    }

    .back:hover {
      color: #16a085;
    }

    main {
      max-width: 850px;
      margin: auto;
      padding: 55px 20px 80px;
    }

    .hero {
      text-align: center;
      margin-bottom: 40px;
    }

    .badge {
      display: inline-block;
      background: #e8f8f5;
      color: #12806a;
      padding: 8px 14px;
      border-radius: 999px;
      font-size: 12px;
      font-weight: 800;
      letter-spacing: 0.4px;
      margin-bottom: 18px;
    }

    .hero h1 {
      font-size: clamp(32px, 5vw, 48px);
      line-height: 1.05;
      margin: 0 0 16px;
      letter-spacing: -1.5px;
    }

    .hero p {
      color: #64748b;
      font-size: 17px;
      max-width: 620px;
      margin: auto;
      line-height: 1.6;
    }

    .calculator {
      display: flex;
      flex-direction: column;
      gap: 18px;
    }

    .card {
      background: white;
      border: 1px solid #e2e8f0;
      border-radius: 18px;
      padding: 25px;
      box-shadow: 0 8px 25px rgba(15, 23, 42, 0.04);
    }

    .card h2 {
      margin: 0 0 20px;
      font-size: 20px;
    }

    .card-description,
    .help {
      color: #64748b;
      font-size: 14px;
      line-height: 1.5;
      margin-top: -8px;
      margin-bottom: 20px;
    }

    label {
      display: flex;
      justify-content: space-between;
      margin-bottom: 8px;
      font-size: 14px;
      font-weight: 700;
    }

    label span {
      color: #94a3b8;
      font-weight: 500;
    }

    input,
    select {
      width: 100%;
      height: 48px;
      border: 1px solid #cbd5e1;
      border-radius: 10px;
      padding: 0 13px;
      font-size: 15px;
      background: white;
      outline: none;
    }

    input:focus,
    select:focus {
      border-color: #16a085;
      box-shadow:
        0 0 0 3px
        rgba(22, 160, 133, 0.1);
    }

    :global(.subject) {
      display: grid;
      grid-template-columns:
        1fr 120px 100px 42px;
      gap: 10px;
      margin-bottom: 10px;
    }

    :global(.subject input),
    :global(.subject select) {
      width: 100%;
      min-width: 0;
      height: 48px;
      border: 1px solid #cbd5e1;
      border-radius: 10px;
      padding: 0 13px;
      font-size: 15px;
      background: white;
      outline: none;
    }

    :global(.subject input:focus),
    :global(.subject select:focus) {
      border-color: #16a085;
      box-shadow:
        0 0 0 3px
        rgba(22, 160, 133, 0.1);
    }

    :global(.subject .remove) {
      width: 42px;
      height: 48px;
      border: 1px solid #fecaca;
      background: #fff5f5;
      color: #dc2626;
      border-radius: 10px;
      font-size: 23px;
      cursor: pointer;
    }

    :global(.subject .remove:hover) {
      background: #fee2e2;
    }

    .add {
      border: 0;
      background: #e8f8f5;
      color: #12806a;
      border-radius: 10px;
      height: 45px;
      padding: 0 18px;
      font-weight: 800;
      cursor: pointer;
      margin-top: 5px;
    }

    .add:hover {
      background: #d8f2ec;
    }

    .calculate {
      width: 100%;
      height: 56px;
      border: 0;
      border-radius: 13px;
      background: #16a085;
      color: white;
      font-size: 16px;
      font-weight: 800;
      cursor: pointer;
      box-shadow:
        0 8px 20px
        rgba(22, 160, 133, 0.2);
    }

    .calculate:hover {
      background: #128f76;
    }

    .error {
      min-height: 20px;
      color: #dc2626;
      text-align: center;
      font-size: 14px;
      font-weight: 600;
    }

    .result {
      display: none;
      background: #0f172a;
      color: white;
      border-radius: 20px;
      padding: 32px 25px;
      text-align: center;
    }

    .result.show {
      display: block;
    }

    .result-label {
      color: #94a3b8;
      margin: 0 0 5px;
      font-size: 14px;
      font-weight: 700;
    }

    .result > strong {
      font-size: 48px;
      line-height: 1;
    }

    .result > span {
      color: #94a3b8;
    }

    .separator {
      width: 100%;
      max-width: 400px;
      height: 1px;
      background: #334155;
      margin: 28px auto;
    }

    .details {
      max-width: 500px;
      margin: 28px auto 0;
      text-align: left;
    }

    .details h3 {
      font-size: 15px;
      margin-bottom: 12px;
    }

    .detail-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 11px 0;
      border-bottom: 1px solid #334155;
    }

    .detail-item small {
      display: block;
      color: #94a3b8;
      margin-top: 3px;
    }

    .detail-item strong {
      color: #5eead4;
    }

    .info {
      margin-top: 50px;
      background: white;
      border: 1px solid #e2e8f0;
      border-radius: 18px;
      padding: 30px;
    }

    .info h2 {
      margin-top: 0;
    }

    .info p {
      color: #64748b;
      line-height: 1.7;
      font-size: 15px;
    }

    .formula {
      background: #f8fafc;
      border-left: 4px solid #16a085;
      padding: 16px;
      margin: 20px 0;
      border-radius: 0 10px 10px 0;
    }

    .formula strong {
      display: block;
      margin-bottom: 7px;
    }

    .formula span {
      color: #475569;
      font-size: 14px;
    }

    .note {
      background: #fff7ed;
      border: 1px solid #fed7aa;
      border-radius: 10px;
      padding: 15px;
    }

    footer {
      border-top: 1px solid #e2e8f0;
      background: white;
      padding: 35px 20px;
      text-align: center;
    }

    .footer-logo {
      font-size: 22px;
    }

    footer p {
      color: #64748b;
      margin: 8px 0 20px;
    }

    .footer-links {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 18px;
      margin-bottom: 20px;
    }

    .footer-links a {
      color: #64748b;
      text-decoration: none;
      font-size: 13px;
    }

    .footer-links a:hover {
      color: #16a085;
    }

    footer small {
      color: #94a3b8;
    }

    @media (max-width: 650px) {
      .header {
        padding: 0 20px;
      }

      :global(.subject) {
        grid-template-columns:
          1fr 1fr 42px;
      }

      :global(.subject .subject-name) {
        grid-column: 1 / 3;
      }

      :global(.subject .subject-grade) {
        grid-column: 1;
      }

      :global(.subject .coefficient) {
        grid-column: 2;
      }

      :global(.subject .remove) {
        grid-column: 3;
        grid-row: 2;
      }

      .card {
        padding: 20px;
      }

      .info {
        padding: 22px;
      }
    }
  </style>
</Layout>