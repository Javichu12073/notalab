<header class="site-header">
  <a href="/" class="logo">
    <span>Nota</span>Lab
  </a>

  <nav>
    <a href="/">Inicio</a>
    <a href="/#herramientas">Calculadoras</a>
    <a href="/#sobre-notalab">Sobre NotaLab</a>
  </nav>
</header>

<style>
  .site-header {
    height: 72px;
    background: white;
    border-bottom: 1px solid #e2e8f0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 7%;
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .logo {
    text-decoration: none;
    color: #0f172a;
    font-size: 25px;
    font-weight: 800;
    letter-spacing: -0.8px;
  }

  .logo span {
    color: #16a085;
  }

  nav {
    display: flex;
    gap: 30px;
  }

  nav a {
    text-decoration: none;
    color: #475569;
    font-size: 14px;
    font-weight: 600;
  }

  nav a:hover {
    color: #16a085;
  }

  @media (max-width: 650px) {
    .site-header {
      padding: 0 20px;
    }

    nav {
      display: none;
    }
  }
</style>